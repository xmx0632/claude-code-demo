{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(mvn clean:*)",
      "Bash(npm run dev)",
      "Bash(git checkout main && git pull)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse *)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse fill:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse snapshot:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse html:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse screenshot:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse html:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse wait:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse url:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse console:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse network:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse goto:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse snapshot:*)",
      "Bash(**/.claude/skills/sdlc-qa-browse/dist/browse js:*)",
      "Bash(mkdir -p .test-report)",
      "Bash(cp /tmp/browse-*.png .test-report/)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .local/prompts && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $(jq -r '.prompt' <<< \"$(cat)\")\" >> .local/prompts/$(date '+%Y-%m-%d').log"
          }
        ]
      }
    ]
  }
}
